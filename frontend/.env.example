# 백엔드 API 베이스 URL (배포: https://triplog11.store, 로컬: http://10.0.2.2:8080 등)
EXPO_PUBLIC_API_URL=

# Google OAuth 웹 클라이언트 ID (백엔드팀 생성 값)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Google 인가코드 redirect_uri — 백엔드 env의 GOOGLE_REDIRECT_URI와 반드시 동일해야 함
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# Naver OAuth 클라이언트 ID (Client Secret은 백엔드에만 보관 — 프론트에 넣지 말 것)
EXPO_PUBLIC_NAVER_CLIENT_ID=

# Naver 콜백 URL — 네이버 개발자 콘솔 등록 값과 동일해야 함
EXPO_PUBLIC_NAVER_REDIRECT_URI=
